# Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info
*.egg
/lead
lead
# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs/Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Scraper data and downloads
tenders/
tenders_backup/

# Sensitive source data (company profile PDF + tender history) — do not commit
EtsplCompanyProfile_2026.pdf
TENDER MASTER SHEET*.xlsx
history.json
data/history.json
scratch/

# Derived cache — rebuildable from the PDFs, keyed by content hash
data/pdf_text_cache/

# Atomic-write temp files (cache entries, config saves)
*.tmp

# One-off audit / analysis dumps — regenerate from tools/, don't commit
audit_*.json
final_audit_*.json
tenders_analysis.json

# Logs (keep directory structure via .gitkeep)
logs/**
!logs/.gitkeep
!logs/scrapes/
!logs/scrapes/.gitkeep
.agents

# Server auth config & cloudflared binaries
config/server_config.json
tools/cloudflared.exe
.cloudflared/