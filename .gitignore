# Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info
*.egg
/lead
lead
# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local Apps Script deployment copy; the sanitized example stays tracked.
/gemsentry/google_sync_script.gs

# Local environment files and credentials (keep distributable examples).
.env
.env.*
!.env.example
!.env.sample
# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs/Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Scraper data and downloads
tenders/
tenders_backup/

# Sensitive source data (company profile PDF + tender history) — do not commit
EtsplCompanyProfile_2026.pdf
TENDER MASTER SHEET*.xlsx
history.json
data/history.json
data/finalized_tenders.json
data/source/*
!data/source/.gitkeep
scratch/

# Derived cache — rebuildable from the PDFs, keyed by content hash
data/pdf_text_cache/

# Atomic-write temp files (cache entries, config saves)
*.tmp

# One-off audit / analysis dumps — regenerate from tools/, don't commit
audit_*.json
final_audit_*.json
tenders_analysis.json

# Logs (keep directory structure via .gitkeep)
logs/**
!logs/.gitkeep
!logs/scrapes/
!logs/scrapes/.gitkeep
.agents
.codex/

# Server auth config & cloudflared binaries
config/server_config.json

# Google Sync config: holds private sheet IDs, URL and webhook secret. Copy
# config/google_sync_config.example.json and fill it in locally, or set
# GEMSENTRY_APPS_SCRIPT_URL / GEMSENTRY_SHEET_ID in the environment.
config/google_sync_config.json
config/company_profile.local.json
data/finalized_tenders.local.json
config/*.local.json
data/*.local.json
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/tech_specs/**
tools/cloudflared.exe
.cloudflared/
