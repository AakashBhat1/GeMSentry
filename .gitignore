# Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info
*.egg

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs/Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Scraper data and downloads
tenders/
tenders_backup/

# Sensitive source data (company profile PDF + tender history) — do not commit
EtsplCompanyProfile_2026.pdf
TENDER MASTER SHEET*.xlsx
history.json
data/history.json
scratch/

# Derived cache — rebuildable from the PDFs, keyed by content hash
data/pdf_text_cache/

# Atomic-write temp files (cache entries, config saves)
*.tmp

# Logs (keep directory structure via .gitkeep)
logs/**
!logs/.gitkeep
!logs/scrapes/
!logs/scrapes/.gitkeep
